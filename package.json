{
	"name": "@walkinissue/angy",
	"version": "0.2.17",
	"description": "Dev-only SvelteKit translation helper for in-app PO catalog lookup, staging, and commit flows.",
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "node ./scripts/build.mjs",
		"test": "npm run build && node --test tests/*.test.mjs",
		"prepare": "npm run build",
		"prepack": "npm run build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./client": {
			"svelte": "./dist/client/Angy.svelte",
			"default": "./dist/client/Angy.svelte"
		},
		"./plugin": {
			"types": "./dist/plugin.d.ts",
			"default": "./dist/plugin.js"
		},
		"./vite": {
			"types": "./dist/plugin.d.ts",
			"default": "./dist/plugin.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"license": "MIT",
	"author": "OtherUser",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/walkingIssue/Angy.git"
	},
	"homepage": "https://github.com/walkingIssue/Angy#readme",
	"bugs": {
		"url": "https://github.com/walkinIssue/Angy/issues"
	},
	"keywords": [
		"i18n",
		"gettext",
		"po",
		"sveltekit",
		"translation",
		"qa",
		"localization",
		"developer-tools"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0",
		"vite": "^6.0.0 || ^7.0.0",
		"wuchale": "^0.21.0"
	},
	"dependencies": {
		"esbuild": "^0.25.0",
		"fuse.js": "^7.1.0",
		"gettext-parser": "^9.0.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	}
}
